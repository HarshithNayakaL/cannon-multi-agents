# Cannon — environment
#
# Every value below is OPTIONAL. With none of them set the app boots, builds,
# passes its tests and serves a fully working demo: inference is simulated,
# data lives in process memory, embeddings are computed locally. Each
# variable you add swaps one fallback for the real thing.
#
# There is no login — Cannon is a personal, single-user tool, and anyone with
# the deployed URL can use it. Groq and Gemini enforce their own free-tier
# rate limits, so Cannon does not layer another one on top.

# ── Inference ────────────────────────────────────────────────────────────────
# Groq is the primary provider (fastest free tier, owns the time-to-first-token
# budget). Gemini is the fallback — a different vendor, so a Groq outage or
# quota wall does not take the assistant down.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides.
CANNON_GROQ_MODEL=llama-3.3-70b-versatile
CANNON_GOOGLE_MODEL=gemini-2.0-flash
CANNON_EMBEDDING_MODEL=gemini-embedding-001

# ── Persistence ──────────────────────────────────────────────────────────────
# Both values are required together; either one alone keeps the memory store.
# Apply supabase/schema.sql before setting these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
