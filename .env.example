# Cannon — environment
#
# Every value below is OPTIONAL. With none of them set the app boots, builds,
# passes its tests and serves a browsable demo: inference is simulated, data
# lives in process memory, embeddings are computed locally and rate limiting
# is per-instance. Each variable you add swaps one fallback for the real thing.

# ── Inference ────────────────────────────────────────────────────────────────
# Groq is the primary provider (fastest free tier, owns the time-to-first-token
# budget). Gemini is the fallback — a different vendor, so a Groq outage or
# quota wall does not take the assistant down.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides.
CANNON_GROQ_MODEL=llama-3.3-70b-versatile
CANNON_GOOGLE_MODEL=gemini-2.0-flash
CANNON_EMBEDDING_MODEL=gemini-embedding-001

# ── Persistence ──────────────────────────────────────────────────────────────
# Both values are required together; either one alone keeps the memory store.
# Apply supabase/schema.sql before setting these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CANNON_RATE_LIMIT_REQUESTS=30
CANNON_RATE_LIMIT_WINDOW_SECONDS=60

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set CANNON_AUTH_SECRET in every real deployment: `openssl rand -base64 32`.
CANNON_AUTH_SECRET=

# Setting a passcode closes the open demo and turns Cannon into a single-user
# app. Combine it with an allowlist to pin it to your own address.
CANNON_AUTH_PASSCODE=
CANNON_ALLOWED_EMAILS=
